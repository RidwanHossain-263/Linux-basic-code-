# Create a new empty HTML file
touch index.html

# Create a new file named taj.txt
touch taj.txt

# Display the current date and time
date

# Display date/time in a specific format
real -h

# Display date/time with another option in juliyan
real -j

# Display date and time
real

# Display the current date and time in UTC
date -u

# Display the current date and time in Universal Time
date --universal


# Sort the contents of taj.txt
sort taj.txt

# Sort the contents and remove duplicate lines
sort -u taj.txt

# Sort the contents in reverse order
sort -r taj.txt

# Sort the contents numerically
sort -n taj.txt

# Sort numerically and remove duplicate lines 
# j line ta sobcheya besi bar ache oital just akber show korba 
sort -nu taj.txt


# Display the Linux kernel release/version
uname -r

# Display CPU architecture and processor information
lscpu

# Display RAM and memory usage in human-readable format

free -h

# Display information about running processes

ps aux

# Display running processes and system resource usage in real time

top

# Trace system calls and signals made by the ls command
strace ls

